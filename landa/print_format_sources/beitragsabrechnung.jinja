<style>
    .print-format {
        margin-left: 0mm;
        margin-right: 0mm;
        margin-top: 10mm;
        margin-bottom: 60mm;
        font-size: 10pt;
    }

    /* Overrides the shared bundle: this statement needs to fit more rows per page. */
    .print-format #text .invoice table td,
    .print-format #text .invoice table th {
        font-size: 8pt;
    }

    .print-format .text-small {
        font-size: 8px;
    }
</style>

{% set company = frappe.get_doc("Company", doc.company) %}
{% set customer = frappe.get_doc("Customer", doc.customer) %}
{% set company_address = frappe.get_doc("Address", doc.company_address) if doc.company_address else None %}
{% set pay_addr = frappe.get_doc("Address", doc.customer_address) if doc.customer_address else None %}

{% if doc.billing_contact %}
    {% set contact = frappe.get_doc("Contact", doc.billing_contact) %}
{% endif %}

<!-- HEAD -->
<div id="header">
    {% if company.company_logo %}
        <img id="logo" src="{{company.company_logo}}">
    {% endif %}
</div>

<div class="contact-row">
    <div id="address">
        <div id="sender">
            <p>{{ company.name }}<br>
                {% if company_address %}
                    {{ company_address.address_line1 }} &#183;
                    {% if company_address.address_line2 %}{{ company_address.address_line2 }} <br>{% endif %}
                    {{ company_address.pincode }} {{ company_address.city }}
                    {% if company_address.country and company_address.country != pay_addr.country -%}
                        &#183; {{ company_address.country.upper() }}
                    {%- endif %}
                {% else %}
                    <i>{{ _("Address not set!") }}</i>
                {% endif %}
            </p>
        </div>
        {% if contact %}
            <strong>{{ contact.first_name }}{% if contact.last_name %} {{ contact.last_name }}{% endif %}</strong><br>
            {{ doc.customer_name }}<br/>
        {% else %}
            <strong>{{ doc.customer_name }}</strong><br />
        {% endif %}
        {{ doc.billing_address_display if doc.billing_address_display else "<i>" + _("Address not set!") + "</i>" }}
    </div>

    <div id="contact">
        <table>
            <tr>
                <td class="text-right">{{ _("Date") }}:</td>
                <td class="text-right">{{ frappe.utils.formatdate(doc.posting_date, "dd. MMMM yyyy") }}</td>
            </tr>
            <tr>
                <td class="text-right">{{ _("Phone") }}:</td>
                <td class="text-right">{{ company.phone_no }}</td>
            </tr>
            <tr>
                <td class="text-right">{{ _("Email") }}:</td>
                <td class="text-right">{{ company.email }}</td>
            </tr>
            <tr>
                <td class="text-right">{{ _("Organization ID") }}:</td>
                <td class="text-right">{{ customer.organization }}</td>
            </tr>
        </table>
    </div>
</div>

<div class="din-mark" id="fold-mark-1"></div>
<div class="din-mark" id="punch-mark"></div>
<div class="din-mark" id="fold-mark-2"></div>

<!-- CONTENT -->
<div id="text" class="">
	<div id="subject">
		<strong>{{ _("Statement of Fees and Payments") }} - {{ doc.year_of_settlement }} - {{ doc.customer_name }}</strong>
    </div>
    <div class="salutation"></div>
    <br>
    <div class="invoice">
        <table class="w-100">
            <thead class="black-border">
                <tr>
                    <th style="width: 5%">{{ _("Sr") }}</th>
                    <th style="width: 30%">{{ _("Item") }}</th>
                    <th style="width: 25%">{{ _("Billed") }}</th>
                    <th style="width: 20%">{{ _("Price") }}</th>
                    <th style="width: 20%" class="text-right">{{ _("Amount") }}</th>
                </tr>
            </thead>
            <tbody>
                {% for n in doc.sales %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>
                        <strong>{{ _(n.item_name) }}</strong>
                    </td>
                    <td>
                        {% if n.billed == n.net_billed %}
                            {{ n.get_formatted("net_billed") }}
                        {% else %}
                            {{ n.get_formatted("billed") }} - {{ n.get_formatted("credited") }}  = {{ n.get_formatted("net_billed") }}
                        {% endif %}
                    </td>
                    <td>{{ n.get_formatted("rate") }}</td>
                    <td class="text-right">{{ n.get_formatted("amount") }}</td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot class="black-border">
                <tr>
                    <td></td>
                    <td><strong>{{ _("Total") }}</strong></td>
                    <td></td>
                    <td></td>
                    <td class="text-right" colspan="2"><strong>{{ doc.get_formatted("sum_of_sales") }}</strong></td>
                </tr>
            </tfoot>
        </table>
        <br>
        <table class="w-50">
            <thead class="black-border">
                <tr>
                    <th style="width: 10%">{{ _("Sr") }}</th>
                    <th style="width: 30%">{{ _("Payment Type") }}</th>
                    <th style="width: 30%">{{ _("Reference Date") }}</th>
                    <th style="width: 30%" class="text-right">{{ _("Amount") }}</th>
                </tr>
            </thead>
            <tbody>
                {% for n in doc.payments %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ _(n.payment_type) }}</td>
                    <td>{{ n.get_formatted("reference_date") }}</td>
                    <td class="text-right">{{ n.get_formatted("amount") }}</td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot class="black-border">
                <tr>
                    <td></td>
                    <td><strong>{{ _("Total") }}</strong></td>
                    <td></td>
                    <td class="text-right"><strong>{{ doc.get_formatted("sum_of_payments") }}</strong></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- FOOTER -->
<div id="footer-html" class="visible-pdf">
    <p id="pagenum">
        {{ _("Page {0} of {1}").format('<span class="page"></span>', '<span class="topage"></span>') }}
    </p>
    <div class="print-format-footer">
         {{ footer }}
    </div>
</div>